# Отправка заказов на почту через Web3Forms.
# Получить ключ: https://web3forms.com — ввести почту, ключ придёт письмом.
# Это публичный access key, а НЕ пароль от почты. Пароль нигде не нужен.
WEB3FORMS_ACCESS_KEY=

# Скопировать этот файл в .env.local и вставить ключ.
# Без ключа сайт работает, заказы пишутся в логи сервера.
