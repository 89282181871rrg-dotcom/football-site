# Куда приходят заявки. Подробная инструкция — в файле ЗАЯВКИ.md
# Скопируй этот файл в .env.local и заполни нужные строки.
# Настраивать можно любое количество каналов, ни один не обязателен.

# Google Таблица: заказ падает строкой
GOOGLE_SHEET_URL=

# Пуш на телефон через ntfy.sh — придумай уникальное название темы
NTFY_TOPIC=

# Письмо на почту через web3forms.com
WEB3FORMS_KEY=
