# Куда приходят заявки. Подробная инструкция — в файле ЗАЯВКИ.md
# Скопируй этот файл в .env.local и заполни нужные строки.
# Настраивать можно любое количество каналов, ни один не обязателен.

# Google Таблица: заказ падает строкой
GOOGLE_SHEET_URL=

# Пуш на телефон через ntfy.sh — придумай уникальное название темы
NTFY_TOPIC=

# Письмо на почту через web3forms.com
WEB3FORMS_KEY=

# ---------------------------------------------------------------
# МойСклад — товары, цены, размеры, остатки и фото. Инструкция: МОЙСКЛАД.md
# Токен: МойСклад → Настройки (шестерёнка) → Токены → Создать токен.
# Без токена сайт показывает встроенный каталог из lib/products.js
MOYSKLAD_TOKEN=

# Название характеристики модификаций с размером (по умолчанию «Размер»)
MOYSKLAD_SIZE_ATTR=

# 1 — 
