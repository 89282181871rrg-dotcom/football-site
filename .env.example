# Куда приходят заявки. Подробная инструкция — в файле ЗАЯВКИ.md
# Скопируй этот файл в .env.local и заполни нужные строки.
# Настраивать можно любое количество каналов, ни один не обязателен.

# Google Таблица: заказ падает строкой
GOOGLE_SHEET_URL=

# Пуш на телефон через ntfy.sh — придумай уникальное название темы
NTFY_TOPIC=

# Письмо на почту через web3forms.com
WEB3FORMS_KEY=

# ---------------------------------------------------------------
# Админка (/admin) — хозяин добавляет товары сам. Инструкция: АДМИНКА.md

# Пароль от входа в /admin. Придумай свой, не оставляй пустым
ADMIN_PASSWORD=

# Хранилище фото и списка добавленных товаров. Появляется здесь
# автоматически, когда подключишь Vercel Blob — вписывать самому не надо
BLOB_READ_WRITE_TOKEN=

# Автоперевод товаров из админки на остальные языки сайта, через DeepL.
# Бесплатный ключ: deepl.com/pro-api → Free plan → Account → API Keys.
# Без ключа сайт работает как раньше — новый товар будет только на русском
DEEPL_API_KEY=
